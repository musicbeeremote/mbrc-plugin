    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.12.0",
    "eslint-plugin-oxlint": "1.87.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "20.14.6",
    "oxlint": "1.87.0",
