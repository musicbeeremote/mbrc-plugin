#!/bin/sh
# The real gate: what CI would fail on, minus what only CI can catch.
#
# Runs on push rather than commit because it takes minutes, not seconds. Each
# check here corresponds to a way this repo has actually broken:
#
#   clippy          - warnings are errors in CI
#   tests           - the core and helper suites
#   bindings drift  - the C# FFI bindings are generated by the core's build.rs and
#                     committed; CI does `git diff --exit-code` on them, so a Rust
#                     FFI change without the regenerated C# fails there and only
#                     there
#   dotnet format   - a new .cs file with the wrong encoding fails CI on CHARSET,
#                     which is invisible locally until you look
#
# What this CANNOT catch: platform-specific breakage. These hooks run on Windows,
# and CI also runs ubuntu - a path literal or a cfg that behaves differently there
# will still get through. That is CI's job and this is not a substitute for it.
#
# Set MBRC_SKIP_HOOKS=1 to skip.

set -e

if [ -n "$MBRC_SKIP_HOOKS" ]; then
    echo "pre-push: skipped (MBRC_SKIP_HOOKS)"
    exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

target="i686-pc-windows-msvc"
fail() { echo; echo "  $1" >&2; exit 1; }

echo "pre-push: cargo clippy ($target)"
cargo clippy --workspace --all-targets --target "$target" -- -D warnings \
    || fail "Clippy warnings are errors in CI. Fix them or re-run with MBRC_SKIP_HOOKS=1."

echo "pre-push: cargo test ($target)"
cargo test --workspace --target "$target" \
    || fail "Tests failed."

# The core's build.rs regenerates the C# bindings; CI fails if the checked-in
# copies do not match. Building above has already refreshed them, so this only
# has to notice they moved.
echo "pre-push: generated FFI bindings are up to date"
if ! git diff --quiet -- packages/plugin/Ffi/Generated; then
    git --no-pager diff --stat -- packages/plugin/Ffi/Generated
    fail "The generated FFI bindings changed. Commit them - never hand-edit them."
fi

if command -v dotnet >/dev/null 2>&1; then
    echo "pre-push: dotnet format --verify-no-changes"
    dotnet format MBRC.sln --verify-no-changes --no-restore \
        || fail "C# formatting issues. Run: dotnet format MBRC.sln"
else
    echo "pre-push: dotnet not on PATH, skipping the C# format check"
fi

echo "pre-push: ok"
